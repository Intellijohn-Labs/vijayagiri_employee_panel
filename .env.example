# Server & Port Configuration
NODE_ENV=production
PORT=3006
HOSTNAME=0.0.0.0

# Portal URL
NEXT_PUBLIC_APP_URL=https://portal.vijayagiriyamaha.com

# PostgreSQL Database Connection
DATABASE_URL="postgresql://vijayagiri_user:PASSWORD_HERE@localhost:5432/vijayagiri_db01?schema=public"

# Auth / Session Secret
NEXTAUTH_URL=https://portal.vijayagiriyamaha.com
NEXTAUTH_SECRET=YOUR_32_CHAR_SECRET_KEY

# Signs the login cookie (falls back to NEXTAUTH_SECRET). Use a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET
