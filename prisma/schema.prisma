// Prisma schema for the Vijayagiri Employee Portal (claims + 10-stage lifecycle).
// The database URL lives in prisma.config.ts (Prisma 7), read from DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One accident-repair claim moving through the 10-stage SOP:
/// 1 Customer Intake & Claim Initiation · 2 Job Card & Claim Number Allocation · 3 Estimation & Insurance Intimation ·
/// 4 Surveyor Showroom Inspection · 5 Spare Parts Ordering · 6 Central Dispatch / Transit · 7 Vehicle Body Repair & Paint ·
/// 8 Final Inspection & Billing · 9 Settlement & Gate Pass · 10 Vehicle Delivery & Closure
model Claim {
  id                 String    @id
  /// Internal reference generated at intake, e.g. CLM-PBR-0012
  ref                String    @unique
  /// Official claim number, assigned at stage 2
  claimNo            String?
  jobCardNumber      String?   @unique
  /// Branch code (Branch.code)
  branchId           String
  customerName       String
  contactNumber      String
  vehicleModel       String
  registrationNumber String
  insuranceCompany   String
  /// Current lifecycle stage, 1–10
  currentStage       Int       @default(1)
  /// "Open" until the vehicle is handed over, then "Delivered"
  status             String    @default("Open")
  /// When the current stage began; every stage SLA counts from here
  stageEnteredAt     DateTime  @default(now())
  closedAt           DateTime?
  createdBy          String    @default("")
  /// The full claim as the portal edits it (estimate, survey, parts, billing, handover, activity log, escalations, …)
  data               Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  jobCard JobCard?
  history StageHistory[]

  @@index([branchId])
  @@index([registrationNumber])
  @@index([currentStage])
}

/// Job Card Ver 2.1 form fields
model JobCard {
  id             String    @id @default(cuid())
  claimId        String    @unique
  claim          Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  date           DateTime  @default(now())
  advisor        String    @default("")
  notes          String    @default("")
  bay            String    @default("")
  couponNo       String    @default("")
  amc            Boolean   @default(false)
  pp             Boolean   @default(false)
  jobType        String    @default("Accidental")
  telReminder    Boolean   @default(false)
  receivedAt     DateTime?
  promisedAt     DateTime?
  engineNo       String    @default("")
  engineCc       String    @default("")
  saleDate       DateTime?
  fuel           String    @default("1/2")
  toolkit        Boolean   @default(false)
  firstAid       Boolean   @default(false)
  serviceManual  Boolean   @default(false)
  returnOldParts Boolean   @default(false)
  supervisor     String    @default("")
  mechanic       String    @default("")
  estParts       Decimal?  @db.Decimal(12, 2)
  estLabour      Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// One row per stage a claim has entered: when it started, when it was completed, its SLA deadline and whether that was missed.
model StageHistory {
  id          String    @id @default(cuid())
  claimId     String
  claim       Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  stageNumber Int
  stageName   String
  enteredAt   DateTime  @default(now())
  completedAt DateTime?
  /// SLA deadline that applied to this stage, when it had one
  dueAt       DateTime?
  breached    Boolean   @default(false)
  remarks     String?
  /// Who last moved or updated the claim in this stage
  updatedBy   String

  @@unique([claimId, stageNumber])
}

model Branch {
  id          String   @id @default(cuid())
  name        String // e.g. "Vijayagiri Yamaha - Perumbavoor"
  code        String   @unique // e.g. "perumbavoor", "hq", "kothamangalam"
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?  @default("Kerala")
  pincode     String?
  managerName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
}

/// Portal staff. Sign-in, the /employees page and access control all read this table.
model Employee {
  id          String   @id @default(cuid())
  /// Employee ID shown on cards, e.g. VAA-EMP-004
  code        String   @unique
  name        String
  email       String?  @unique
  phone       String   @unique
  whatsapp    String?
  /// Admin, Showroom Manager, Sales Executive or Inventory Officer
  role        String   @default("Sales Executive")
  designation String?
  /// Primary showroom (Branch.id); the portal itself refers to showrooms by Branch.code
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  /// True for central staff who may see every showroom
  allBranches Boolean  @default(false)
  /// Branch codes this person may see when `allBranches` is false
  branchCodes String[] @default([])
  /// scrypt hash ("scrypt$salt$hash"). Null until the employee activates their account from the sign-in screen.
  password    String?
  /// Profile photo as a small data URL
  photo       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
